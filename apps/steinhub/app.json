{
  "expo": {
    "name": "SteinHub",
    "slug": "steinhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "steinhub",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.cmdl.steinhub",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cmdl.steinhub",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
