+// The widest run of non-space characters in a cell: a column narrower than this would break a word or a number.
+static CGFloat ENRMTableLongestWordWidth(NSAttributedString *text)
+{
+  NSString *string = text.string;
+  NSCharacterSet *spaces = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+  NSUInteger length = string.length;
+  NSUInteger start = 0;
+  CGFloat widest = 0;
+  while (start < length) {
+    while (start < length && [spaces characterIsMember:[string characterAtIndex:start]])
+      start++;
+    NSUInteger end = start;
+    while (end < length && ![spaces characterIsMember:[string characterAtIndex:end]])
+      end++;
+    if (end > start) {
+      CGRect rect = [[text attributedSubstringFromRange:NSMakeRange(start, end - start)]
+          boundingRectWithSize:CGSizeMake(CGFLOAT_MAX, CGFLOAT_MAX)
+                       options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading
+                       context:nil];
+      widest = MAX(widest, ceil(rect.size.width));
+    }
+    start = end;
+  }
+  return widest;
+}
+
+// Shrinks a table wider than maxWidth to fit it, each column no narrower than its floor (its longest word), so words
+// wrap whole. A table that cannot fit at its floors keeps its natural widths and scrolls.
+static void ENRMTableFitColumns(NSMutableArray<NSNumber *> *colWidths, NSArray<NSNumber *> *floors, CGFloat maxWidth,
+                                CGFloat borderWidth)
+{
+  NSUInteger count = colWidths.count;
+  CGFloat available = maxWidth - borderWidth;
+  if (maxWidth <= 0 || count == 0)
+    return;
+  CGFloat total = 0;
+  CGFloat floorTotal = 0;
+  CGFloat widest = 0;
+  for (NSUInteger i = 0; i < count; i++) {
+    CGFloat width = colWidths[i].doubleValue;
+    total += width;
+    floorTotal += MIN(floors[i].doubleValue, width);
+    widest = MAX(widest, width);
+  }
+  if (total <= available || floorTotal > available)
+    return;
+  CGFloat low = 0;
+  CGFloat high = widest;
+  for (int step = 0; step < 40; step++) {
+    CGFloat share = (low + high) / 2;
+    CGFloat sum = 0;
+    for (NSUInteger i = 0; i < count; i++)
+      sum += MIN(colWidths[i].doubleValue, MAX(floors[i].doubleValue, share));
+    if (sum > available)
+      high = share;
+    else
+      low = share;
+  }
+  for (NSUInteger i = 0; i < count; i++)
+    colWidths[i] = @(floor(MIN(colWidths[i].doubleValue, MAX(floors[i].doubleValue, low))));
+}
