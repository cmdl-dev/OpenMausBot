+// Shrinks a table wider than maxWidth to fit it: columns already narrower than an even share keep their width, the
+// rest split what is left and wrap. A table that cannot fit at the minimum column width keeps its natural widths and
+// scrolls.
+static void ENRMTableFitColumns(NSMutableArray<NSNumber *> *colWidths, CGFloat maxWidth, CGFloat borderWidth,
+                                CGFloat minimumColumnWidth)
+{
+  NSUInteger count = colWidths.count;
+  CGFloat available = maxWidth - borderWidth;
+  if (maxWidth <= 0 || count == 0 || available < minimumColumnWidth * count)
+    return;
+  CGFloat total = 0;
+  for (NSNumber *width in colWidths)
+    total += width.doubleValue;
+  if (total <= available)
+    return;
+
+  NSMutableArray<NSNumber *> *open = [NSMutableArray arrayWithCapacity:count];
+  for (NSUInteger i = 0; i < count; i++)
+    [open addObject:@(i)];
+  CGFloat remaining = available;
+  BOOL settled = NO;
+  while (!settled && open.count > 0) {
+    settled = YES;
+    CGFloat share = remaining / open.count;
+    for (NSInteger j = (NSInteger)open.count - 1; j >= 0; j--) {
+      NSUInteger column = open[(NSUInteger)j].unsignedIntegerValue;
+      CGFloat width = colWidths[column].doubleValue;
+      if (width <= share) {
+        remaining -= width;
+        [open removeObjectAtIndex:(NSUInteger)j];
+        settled = NO;
+      }
+    }
+  }
+  if (open.count == 0)
+    return;
+  CGFloat share = floor(remaining / open.count);
+  for (NSNumber *column in open)
+    colWidths[column.unsignedIntegerValue] = @(MAX(share, minimumColumnWidth));
+}
